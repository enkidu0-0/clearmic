  "productName": "ClearMic",
  "version": "0.1.0",
  "identifier": "dev.clearmic.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
